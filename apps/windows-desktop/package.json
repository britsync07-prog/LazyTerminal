    "package": "node scripts/package-win.js"
  },
  "dependencies": {
    "@lazyterminal/protocol": "workspace:*",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@types/ws": "^8.5.14",
    "electron": "32.3.3",
    "electron-packager": "^17.1.2",
    "typescript": "^5.8.2"
  }
}
