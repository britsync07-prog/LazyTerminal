{
  "name": "@lazyterminal/windows-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "LazyTerminal Windows Desktop GUI - Terminal Mirror & Session Manager",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -b && node scripts/copy-assets.js",
