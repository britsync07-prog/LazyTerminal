{
  "name": "@lazyterminal/windows-agent",
  "version": "0.1.0",
  "private": true,
  "description": "LazyTerminal Windows Agent - Node.js PTY service for PowerShell",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "viewer": "tsx src/viewer.ts"
  },
  "dependencies": {
    "@lazyterminal/protocol": "workspace:*",
    "node-pty": "^1.1.0",
    "ws": "^8.18.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@types/ws": "^8.5.14",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
